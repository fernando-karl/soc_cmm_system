# =============================================================================
# SOC CMM Assessment System — example environment file
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Generate strong values with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Secret used to sign JWT tokens.
# The application refuses to start if this variable is missing or empty.
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# REQUIRED only for initial bootstrap (migrate_to_auth.py).
# Initial password for the default `admin` user. After first login change it
# from the admin UI and remove this variable from the environment.
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=change-me-on-first-login

# -----------------------------------------------------------------------------
# OPTIONAL: CORS origins allowed by the API.
# Comma-separated list. Use `*` ONLY in trusted, isolated networks.
# Default (when unset): http://localhost:8000
# -----------------------------------------------------------------------------
# ALLOWED_ORIGINS=http://localhost:8000,https://soc-cmm.example.com

# -----------------------------------------------------------------------------
# OPTIONAL: JWT access-token lifetime in minutes (default: 30)
# -----------------------------------------------------------------------------
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# OPTIONAL: Network binding for the development server.
# HOST default: 0.0.0.0  (listen on all interfaces)
# PORT default: 8400
# -----------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8400
