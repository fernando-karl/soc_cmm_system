# =============================================================================
# SOC CMM Assessment System — example environment file
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Generate strong values with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Secret used to sign JWT tokens.
# The application refuses to start if this variable is missing or empty.
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# REQUIRED only for initial bootstrap (migrate_to_auth.py).
# Initial password for the default `admin` user. After first login change it
# from the admin UI and remove this variable from the environment.
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=change-me-on-first-login

# -----------------------------------------------------------------------------
# OPTIONAL: CORS origins allowed by the API.
# Comma-separated list. Use `*` ONLY in trusted, isolated networks.
# Default (when unset): http://localhost:<PORT>, i.e. http://localhost:8400
# -----------------------------------------------------------------------------
# ALLOWED_ORIGINS=http://localhost:8400,https://soc-cmm.example.com

# -----------------------------------------------------------------------------
# OPTIONAL: session lifetime in minutes (default: 480, i.e. 8 hours).
# Both the JWT and the cookie carrying it expire after this long. Filling in a
# full assessment takes hours, so a short value logs people out mid-answer.
# -----------------------------------------------------------------------------
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# OPTIONAL: `Secure` flag on the session cookie.
# When unset it follows ALLOWED_ORIGINS: on when every origin is https://,
# off otherwise — because a browser never sends a secure cookie over plain
# HTTP, so forcing it on for http://localhost breaks login entirely.
# Set it explicitly to `true` behind a TLS-terminating proxy, where the
# application itself still speaks HTTP.
# -----------------------------------------------------------------------------
# COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# OPTIONAL: `SameSite` policy for the session cookie (default: lax).
# `strict` is tighter but drops the cookie on cross-site navigation back into
# the application.
# -----------------------------------------------------------------------------
# COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# OPTIONAL: SQLite database location.
# Defaults to `soc_cmm_bilingual.db` next to the application code.
# In Docker this MUST point inside the mounted volume, otherwise the database
# is recreated empty on every rebuild.
# -----------------------------------------------------------------------------
# DB_PATH=/app/data/soc_cmm_bilingual.db

# -----------------------------------------------------------------------------
# OPTIONAL: Network binding for the development server.
# HOST default: 0.0.0.0  (listen on all interfaces)
# PORT default: 8400
# -----------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8400
