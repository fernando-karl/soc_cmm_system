# =============================================================================
# Project-specific
# =============================================================================

# Local SQLite databases — never commit user data
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Database backups made by this project's own migration tooling. Each pattern
# below matches a name some script actually writes, so a timestamped copy of a
# live database can never be staged:
#   scripts/migrate_to_auth.py        <db>.backup_<timestamp>
#   scripts/run_admin_migration.py    <db>.backup_admin_<timestamp>
#   scripts/migrate_bilingual.py      <db>.bak_<timestamp>
#   scripts/legacy/...                soc_cmm_backup_<timestamp>.db
# `*.db` alone does not cover them: a suffix after `.db` means the name no
# longer ends in `.db`, which is how `*.db.bak_<timestamp>` slipped through.
*.db.*
*.backup
*.backup_*
*.bak
*.bak_*
*_backup_*
*_backup.*

# Editor and local tooling
.cursor/
.vscode/
.idea/

# Patch files / diffs from local development
*.patch
*.diff
!*.example.patch

# Application logs
*.log
logs/

# Local uploads / runtime artefacts
uploads/
tmp/
temp/

# Jupyter / scratch
.ipynb_checkpoints/

# Secret material — never commit
secrets/
*.pem
*.key
*.crt
