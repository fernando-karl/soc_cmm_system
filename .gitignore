# =============================================================================
# Project-specific
# =============================================================================

# Local SQLite databases — never commit user data
*.db
*.db-journal
*.db.backup_*
*.sqlite
*.sqlite3

# Backup files generated by translation / migration tooling
*.backup
*.bak
*_backup_*

# Patch files / diffs from local development
*.patch
*.diff
!*.example.patch

# Application logs
*.log
logs/

# Local uploads / runtime artefacts
uploads/
tmp/
temp/

# Jupyter / scratch
.ipynb_checkpoints/

# Secret material — never commit
secrets/
*.pem
*.key
*.crt
